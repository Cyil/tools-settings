# ============================================
# Ghostty Terminal - Complete Configuration
# ============================================
# File: ~/.config/ghostty/config
# Optimized and Fixed for Linux (Ubuntu)

# --- Typography (字体设置) ---
font-family = "Maple Mono NF CN"
font-size = 14
font-thicken = true
adjust-cell-height = 2

# --- Theme and Colors (主题) ---
theme = Catppuccin Mocha

# --- Window and Appearance (窗口与毛玻璃) ---
background-opacity = 0.90
window-save-state = always
window-width = 125
window-height = 40
window-padding-x = 10
window-padding-y = 8
window-theme = auto

# --- Cursor (光标) ---
cursor-style = bar
cursor-style-blink = true
cursor-opacity = 0.8

# --- Mouse (鼠标行为) ---
mouse-hide-while-typing = true
copy-on-select = clipboard
mouse-scroll-multiplier = 3

# --- Security (安全防护) ---
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

# --- Shell Integration (Shell 整合) ---
shell-integration = detect

# --- Performance & Limits (性能与缓存限制) ---
# 限制在合理的 10 万以内，防止吃干显卡 VRAM
scrollback-limit = 100000

# --- GTK 性能单实例优化 (Linux 闪开专用) ---
gtk-single-instance = true
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 5m

# ============================================
# --- Keybindings (快捷键完美映射) ---
# ============================================

# Tabs (标签页管理)
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+left=previous_tab
keybind = ctrl+shift+right=next_tab
keybind = ctrl+shift+w=close_surface

# Splits (原生分屏管理)
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+alt+d=new_split:down
keybind = ctrl+alt+left=goto_split:left
keybind = ctrl+alt+right=goto_split:right
keybind = ctrl+alt+up=goto_split:top
keybind = ctrl+alt+down=goto_split:bottom

# Font size (字体缩放)
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# Splits management (分屏高级布局)
keybind = ctrl+shift+e=equalize_splits
keybind = ctrl+shift+f=toggle_split_zoom

# Reload config (重载此配置文件)
keybind = ctrl+shift+comma=reload_config

# 显式指定启动时运行的命令为 zsh
command = /bin/zsh

# 开启 Ghostty 的 Shell 集成功能
shell-integration = zsh

term = xterm-256color
